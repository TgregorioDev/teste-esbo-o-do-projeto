{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "tests/**/*.js",
    "pages/**/*.js",
    "components/**/*.js",
    "fixtures/**/*.js",
    "factories/**/*.js",
    "utils/**/*.js",
    "config/**/*.js",
    "playwright.config.js"
  ],
  "exclude": [
    "node_modules",
    "test-results",
    "playwright-report"
  ]
}
