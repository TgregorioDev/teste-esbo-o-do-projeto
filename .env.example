# Copie para .env.test e preencha. NUNCA commite o .env.test.
# Segredos jamais ficam no código ou no repositório.

# --- Obrigatórias ---

# Ambiente Fluig sob teste
BASE_URL=

# Credencial da automação (usuário com o grupo G.P.Acompanhamento_Renovacao_Contratos)
QA_USERNAME=
QA_PASSWORD=

# --- Opcionais ---

# Personas (config/personas.js) — uma conta por perfil de negócio. Sem as duas variáveis, os testes
# que pedem a persona falham como PRÉ-CONDIÇÃO dizendo o que falta. Nomes dos pedidos: ver
# docs/plano-de-evolucao-2026-09-11.md.
# QA_COMPRADOR_USERNAME=        # E2 — comprador na SY1
# QA_COMPRADOR_PASSWORD=
# QA_FISCAL_USERNAME=           # E4 — fiscal de contrato
# QA_FISCAL_PASSWORD=
# QA_CSE_USERNAME=              # E4 — aprovador CSE
# QA_CSE_PASSWORD=
# QA_GESTOR_ALCADA_USERNAME=    # E4 — gestor de alçada
# QA_GESTOR_ALCADA_PASSWORD=

# Prefixo que identifica na base tudo que foi criado pela automação (default: QA)
QA_DATA_PREFIX=QA

# Fixa a seed do faker para reproduzir exatamente a massa de uma execução.
# A seed usada em cada run fica anexada ao relatório.
FAKER_SEED=

# NÃO existe variável de contrato aqui, e é de propósito.
# A massa de contratos é descoberta em tempo de execução, a partir da própria grade do portal
# (ver utils/massa-contratos.js): o teste declara a característica de que precisa — contrato
# vigente, de filial diferente de outro — e a suíte escolhe um que sirva.
# Fixar um número de contrato faria a suíte quebrar no dia em que alguém o finalizasse,
# cancelasse ou revisasse, por um motivo que não é defeito do produto.
