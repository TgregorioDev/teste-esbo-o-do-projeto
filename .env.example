# Copie para .env.test e preencha. NUNCA commite o .env.test.
# Segredos jamais ficam no código ou no repositório.

# Ambiente Fluig sob teste
BASE_URL=

# Credencial da automação (usuário com o grupo G.P.Acompanhamento_Renovacao_Contratos)
QA_USERNAME=
QA_PASSWORD=

# Massa homologada de contratos (ver README > Massa de teste).
# Ficam em env para não versionar identificadores do cliente neste repositório.
CONTRATO_LIMPO=
CONTRATO_MEDIO=
CONTRATO_SERVICO=
CONTRATO_VOLUMOSO=

# Massa de teste
# Prefixo que identifica na base tudo que foi criado pela automação (default: QA)
QA_DATA_PREFIX=QA
# Opcional: fixa a seed do faker para reproduzir exatamente a massa de uma execução.
# A seed usada em cada run fica anexada ao relatório.
FAKER_SEED=
